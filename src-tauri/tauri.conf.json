{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Imposter",
  "version": "1.1.0",
  "identifier": "com.imposter.party",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1428",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IMPOSTER",
        "width": 430,
        "height": 880,
        "minWidth": 340,
        "minHeight": 640,
        "backgroundColor": "#141916"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "android": {
      "minSdkVersion": 26
    }
  }
}
